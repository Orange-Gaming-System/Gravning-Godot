;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

AutoExportVersion/version_store_location=0
AutoExportVersion/version_file_path="res://version/exported.gd"
AutoExportVersion/version_config_file="res://version/autoversion.gd"

[application]

config/name="Grävning"
run/main_scene="uid://hk5lwnpx01ec"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="uid://d2n8ayfjq3mgh"

[autoload]

GameManager="*res://game_manager.gd"
LevelBuilder="*res://level_builder.gd"
SettingsManager="*uid://c2828wwj1rneg"

[display]

window/size/viewport_width=672
window/size/viewport_height=464
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Gravning Godot A2"

[editor]

movie_writer/movie_file="res://movies/movie.png"

[editor_plugins]

enabled=PackedStringArray("res://addons/AutoExportVersion/plugin.cfg")

[gui]

theme/custom="uid://c7jrhubx5eew8"

